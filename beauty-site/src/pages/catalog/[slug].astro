---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const products = await getCollection('catalog');
  return products.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const categoryLabels: Record<string, string> = {
  manicure: 'Маникюр',
  pedicure: 'Педикюр',
  sterilization: 'Стерилизация',
  hairdressing: 'Парикмахерская',
  cosmetology: 'Косметология',
  waiting: 'Зона ожидания',
  kits: 'Комплекты',
};

const whatsappText = encodeURIComponent(`Здравствуйте! Интересует ${entry.data.title}`);
---

<BaseLayout
  title={`${entry.data.title} — Стиль Салон`}
  description={entry.data.description}
>
  <!-- Hero -->
  <section class="bg-primary-light py-8 md:py-12">
    <div class="max-w-7xl mx-auto px-4 md:px-6">
      <nav class="flex gap-2 text-sm text-text-secondary">
        <a href="/" class="hover:text-primary">Главная</a>
        <span>/</span>
        <a href="/catalog" class="hover:text-primary">Каталог</a>
        <span>/</span>
        <span class="text-text">{entry.data.title}</span>
      </nav>
    </div>
  </section>

  <!-- Контент -->
  <section class="bg-white py-12 md:py-16">
    <div class="max-w-4xl mx-auto px-4 md:px-6">
      <!-- Бейджи -->
      <div class="flex flex-wrap items-center gap-3 mb-6">
        <span class="bg-warm-pink text-primary rounded-full px-3 py-1 text-sm">
          {categoryLabels[entry.data.category]}
        </span>
        {entry.data.brand && (
          <span class="bg-gray-100 text-text-secondary rounded-full px-3 py-1 text-sm">
            {entry.data.brand}
          </span>
        )}
      </div>

      <!-- Заголовок -->
      <h1 class="font-heading text-3xl md:text-4xl font-bold text-text">{entry.data.title}</h1>

      <!-- Цена -->
      <div class="mt-4">
        <span class="text-cta font-bold text-2xl md:text-3xl">от {entry.data.priceFrom}</span>
        {entry.data.priceTo && (
          <span class="text-cta font-bold text-2xl md:text-3xl"> до {entry.data.priceTo}</span>
        )}
      </div>

      <!-- MDX контент -->
      <div class="mt-8 prose-content">
        <Content />
      </div>

      <!-- CTA блок -->
      <div class="mt-12 bg-primary-light rounded-2xl p-6 md:p-8">
        <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
          <div>
            <p class="font-heading text-xl font-bold text-text">Интересует {entry.data.title}?</p>
            <p class="text-text-secondary text-sm">Напишите — подберём оптимальный вариант</p>
          </div>
          <div class="flex gap-3">
            <a
              href={`https://wa.me/89244496355?text=${whatsappText}`}
              class="bg-cta text-white rounded-xl px-6 py-3 font-semibold hover:bg-cta-dark transition-all"
            >
              Написать в WhatsApp
            </a>
            <a
              href="tel:+79244496355"
              class="border-2 border-primary text-primary rounded-xl px-6 py-3 font-semibold hover:bg-primary hover:text-white transition-all"
            >
              Позвонить
            </a>
          </div>
        </div>
      </div>

      <!-- Назад -->
      <a href="/catalog" class="mt-8 text-primary hover:underline font-medium inline-block">&larr; Назад к каталогу</a>
    </div>
  </section>
</BaseLayout>

<style is:global>
  .prose-content h2 {
    font-family: var(--font-heading);
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--color-text);
    margin-top: 2rem;
    margin-bottom: 1rem;
  }
  .prose-content h3 {
    font-family: var(--font-heading);
    font-size: 1.375rem;
    font-weight: 700;
    color: var(--color-text);
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
  }
  .prose-content p {
    color: var(--color-text-secondary);
    line-height: 1.75;
    margin-bottom: 1rem;
  }
  .prose-content strong {
    color: var(--color-text);
    font-weight: 600;
  }
  .prose-content ul, .prose-content ol {
    color: var(--color-text-secondary);
    line-height: 1.75;
    margin-bottom: 1rem;
    padding-left: 1.5rem;
  }
  .prose-content ul {
    list-style-type: disc;
  }
  .prose-content ol {
    list-style-type: decimal;
  }
  .prose-content li {
    margin-bottom: 0.25rem;
  }
  .prose-content a {
    color: var(--color-primary);
    text-decoration: underline;
  }
  .prose-content a:hover {
    color: var(--color-primary-dark);
  }
  .prose-content blockquote {
    border-left: 4px solid var(--color-primary);
    background: color-mix(in srgb, var(--color-primary-light) 50%, transparent);
    border-radius: 0 0.75rem 0.75rem 0;
    padding: 1rem 1.25rem;
    margin: 1.5rem 0;
    font-style: italic;
  }
  .prose-content blockquote p {
    color: var(--color-text);
    margin-bottom: 0;
  }
</style>
