---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);

function formatDate(date: Date): string {
  const d = new Date(date);
  return d.toLocaleDateString('ru-RU', { day: '2-digit', month: '2-digit', year: 'numeric' });
}
---

<BaseLayout
  title="Блог — Стиль Салон | Советы по выбору оборудования"
  description="Экспертные статьи о выборе бьюти-оборудования, открытии салона, социальных контрактах. Полезно для мастеров и владельцев салонов."
>
  <!-- Hero -->
  <section class="bg-primary-light py-16 md:py-20">
    <div class="max-w-7xl mx-auto px-4 md:px-6">
      <nav class="flex gap-2 text-sm text-text-secondary mb-8">
        <a href="/" class="hover:text-primary">Главная</a>
        <span>/</span>
        <span class="text-text">Блог</span>
      </nav>
      <h1 class="font-heading text-3xl md:text-4xl lg:text-5xl font-bold text-burgundy">Блог</h1>
      <p class="text-text-secondary text-lg mt-4">Полезные статьи для мастеров и владельцев салонов</p>
    </div>
  </section>

  <!-- Сетка статей -->
  <section class="bg-white py-12 md:py-16">
    <div class="max-w-7xl mx-auto px-4 md:px-6">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {posts.map((entry) => (
          <article class="bg-white rounded-2xl shadow-md overflow-hidden hover:shadow-lg hover:-translate-y-1 transition-all">
            <div class="aspect-[16/9] bg-gradient-to-br from-warm-pink to-primary-light flex items-center justify-center">
              <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-primary/30">
                <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
              </svg>
            </div>
            <div class="p-5 md:p-6">
              <span class="bg-warm-pink text-primary text-xs font-medium rounded-full px-3 py-1">
                {entry.data.category}
              </span>
              <h2 class="font-heading text-lg font-semibold text-text mt-2">
                <a href={`/blog/${entry.id}`} class="hover:text-primary transition-colors">
                  {entry.data.title}
                </a>
              </h2>
              <p class="text-text-secondary text-sm mt-2 line-clamp-2">{entry.data.description}</p>
              <div class="flex items-center justify-between mt-4">
                <span class="text-text-secondary text-xs">{formatDate(entry.data.date)}</span>
                <a href={`/blog/${entry.id}`} class="text-primary font-semibold text-sm hover:underline">
                  Читать &rarr;
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
