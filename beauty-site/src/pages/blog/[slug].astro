---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

function formatDate(date: Date): string {
  const d = new Date(date);
  return d.toLocaleDateString('ru-RU', { day: '2-digit', month: '2-digit', year: 'numeric' });
}

const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": entry.data.title,
  "description": entry.data.description,
  "datePublished": entry.data.date.toISOString(),
  "author": {
    "@type": "Organization",
    "name": "Стиль Салон"
  }
};
---

<BaseLayout
  title={`${entry.data.title} — Блог Стиль Салон`}
  description={entry.data.description}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />
  </Fragment>

  <!-- Breadcrumbs -->
  <section class="bg-primary-light py-8 md:py-12">
    <div class="max-w-7xl mx-auto px-4 md:px-6">
      <nav class="flex gap-2 text-sm text-text-secondary">
        <a href="/" class="hover:text-primary">Главная</a>
        <span>/</span>
        <a href="/blog" class="hover:text-primary">Блог</a>
        <span>/</span>
        <span class="text-text line-clamp-1">{entry.data.title}</span>
      </nav>
    </div>
  </section>

  <!-- Контент -->
  <section class="bg-white py-12 md:py-16">
    <div class="max-w-3xl mx-auto px-4 md:px-6">
      <!-- Мета -->
      <div class="flex gap-3 items-center">
        <span class="bg-warm-pink text-primary text-xs font-medium rounded-full px-3 py-1">
          {entry.data.category}
        </span>
        <span class="text-text-secondary text-sm">{formatDate(entry.data.date)}</span>
      </div>

      <h1 class="font-heading text-3xl md:text-4xl font-bold text-text mt-4">{entry.data.title}</h1>

      <!-- MDX -->
      <div class="mt-8 prose-content">
        <Content />
      </div>

      <!-- CTA -->
      <div class="bg-primary-light rounded-2xl p-6 mt-12">
        <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
          <div>
            <p class="font-heading text-xl font-bold text-text">Нужна помощь с выбором?</p>
            <p class="text-text-secondary text-sm">Напишите — подберём оптимальный вариант</p>
          </div>
          <a
            href="https://wa.me/89244496355?text=%D0%97%D0%B4%D1%80%D0%B0%D0%B2%D1%81%D1%82%D0%B2%D1%83%D0%B9%D1%82%D0%B5!%20%D0%A5%D0%BE%D1%87%D1%83%20%D1%83%D0%B7%D0%BD%D0%B0%D1%82%D1%8C%20%D0%BF%D1%80%D0%BE%20%D0%BE%D0%B1%D0%BE%D1%80%D1%83%D0%B4%D0%BE%D0%B2%D0%B0%D0%BD%D0%B8%D0%B5"
            class="bg-cta text-white rounded-xl px-6 py-3 font-semibold hover:bg-cta-dark transition-all shrink-0"
          >
            Написать в WhatsApp
          </a>
        </div>
      </div>

      <!-- Назад -->
      <a href="/blog" class="mt-8 text-primary hover:underline font-medium inline-block">&larr; Назад к блогу</a>
    </div>
  </section>
</BaseLayout>

<style is:global>
  .prose-content h2 {
    font-family: var(--font-heading);
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--color-text);
    margin-top: 2rem;
    margin-bottom: 1rem;
  }
  .prose-content h3 {
    font-family: var(--font-heading);
    font-size: 1.375rem;
    font-weight: 700;
    color: var(--color-text);
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
  }
  .prose-content p {
    color: var(--color-text-secondary);
    line-height: 1.75;
    margin-bottom: 1rem;
  }
  .prose-content strong {
    color: var(--color-text);
    font-weight: 600;
  }
  .prose-content ul, .prose-content ol {
    color: var(--color-text-secondary);
    line-height: 1.75;
    margin-bottom: 1rem;
    padding-left: 1.5rem;
  }
  .prose-content ul {
    list-style-type: disc;
  }
  .prose-content ol {
    list-style-type: decimal;
  }
  .prose-content li {
    margin-bottom: 0.25rem;
  }
  .prose-content a {
    color: var(--color-primary);
    text-decoration: underline;
  }
  .prose-content a:hover {
    color: var(--color-primary-dark);
  }
  .prose-content blockquote {
    border-left: 4px solid var(--color-primary);
    background: color-mix(in srgb, var(--color-primary-light) 50%, transparent);
    border-radius: 0 0.75rem 0.75rem 0;
    padding: 1rem 1.25rem;
    margin: 1.5rem 0;
    font-style: italic;
  }
  .prose-content blockquote p {
    color: var(--color-text);
    margin-bottom: 0;
  }
</style>
