---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
---

<BaseLayout
  title="Контакты — Стиль Салон | Магазин оборудования для салонов красоты"
  description="Адрес: Благовещенск, ул. Центральная, Л31, Чигири. Телефон: 8-924-449-63-55. Часы: 10:00–18:00. WhatsApp, Telegram."
>
  <!-- Секция 1: Hero -->
  <section class="bg-primary-light py-16 md:py-20">
    <div class="max-w-7xl mx-auto px-4 md:px-6">
      <nav class="flex gap-2 text-sm text-text-secondary mb-8">
        <a href="/" class="hover:text-primary">Главная</a>
        <span>/</span>
        <span class="text-text">Контакты</span>
      </nav>
      <h1 class="font-heading text-3xl md:text-4xl lg:text-5xl font-bold text-burgundy">Свяжитесь с нами</h1>
      <p class="text-text-secondary text-lg md:text-xl mt-4">Ответим на вопросы, подберём оборудование, рассчитаем бюджет</p>
    </div>
  </section>

  <!-- Секция 2: Контакты + Форма -->
  <section class="bg-white py-16 md:py-24">
    <div class="grid md:grid-cols-2 gap-8 md:gap-12 max-w-7xl mx-auto px-4 md:px-6">
      <!-- Левая колонка: контактная информация -->
      <div>
        <!-- Телефоны -->
        <div class="mb-8">
          <h2 class="font-heading text-xl font-bold text-text mb-4">Телефоны</h2>
          <div class="flex items-center gap-3 mb-3">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary shrink-0">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
            </svg>
            <div>
              <a href="tel:+79244496355" class="text-text hover:text-primary font-medium text-lg">8-924-449-63-55</a>
              <span class="text-text-secondary text-sm ml-2">(WhatsApp)</span>
            </div>
          </div>
          <div class="flex items-center gap-3">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary shrink-0">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
            </svg>
            <a href="tel:+79244497388" class="text-text hover:text-primary font-medium text-lg">8-924-449-73-88</a>
          </div>
        </div>

        <!-- Мессенджеры -->
        <div class="mb-8">
          <h2 class="font-heading text-xl font-bold text-text mb-4">Напишите нам</h2>
          <a href="https://wa.me/89244496355" class="flex items-center gap-3 mb-3 text-text hover:text-primary">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" class="text-primary shrink-0">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            <span>WhatsApp</span>
          </a>
          <a href="https://t.me/stil_salon_rf" class="flex items-center gap-3 mb-3 text-text hover:text-primary">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" class="text-primary shrink-0">
              <path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.479.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/>
            </svg>
            <span>Telegram</span>
          </a>
          <a href="https://vk.com/stil_salon_rf" class="flex items-center gap-3 mb-3 text-text hover:text-primary">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" class="text-primary shrink-0">
              <path d="M15.684 0H8.316C1.592 0 0 1.592 0 8.316v7.368C0 22.408 1.592 24 8.316 24h7.368C22.408 24 24 22.408 24 15.684V8.316C24 1.592 22.391 0 15.684 0zm3.692 17.123h-1.744c-.66 0-.864-.525-2.05-1.727-1.033-1-1.49-1.135-1.744-1.135-.356 0-.458.102-.458.593v1.575c0 .424-.135.678-1.253.678-1.846 0-3.896-1.118-5.335-3.202C4.624 10.857 4.03 8.57 4.03 8.096c0-.254.102-.491.593-.491h1.744c.44 0 .61.203.78.678.863 2.49 2.303 4.675 2.896 4.675.22 0 .322-.102.322-.66V9.721c-.068-1.186-.695-1.287-.695-1.71 0-.203.17-.407.44-.407h2.744c.372 0 .508.203.508.644v3.473c0 .372.17.508.271.508.22 0 .407-.136.813-.542 1.27-1.422 2.18-3.608 2.18-3.608.119-.254.322-.491.763-.491h1.744c.525 0 .644.27.525.644-.22 1.017-2.354 4.031-2.354 4.031-.186.305-.254.44 0 .78.186.254.796.78 1.203 1.253.745.847 1.32 1.558 1.473 2.05.17.49-.085.744-.576.744z"/>
            </svg>
            <span>ВКонтакте</span>
          </a>
          <a href="https://ok.ru/group/70000030836320" class="flex items-center gap-3 mb-3 text-text hover:text-primary">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" class="text-primary shrink-0">
              <path d="M14.505 17.44a11.97 11.97 0 0 0 3.055-1.42.75.75 0 0 0-.75-1.3 10.5 10.5 0 0 1-9.62 0 .75.75 0 1 0-.75 1.3c.96.554 2 .96 3.055 1.42L6.67 20.265a.75.75 0 0 0 1.06 1.06L12 17.06l4.27 4.265a.75.75 0 0 0 1.06-1.06l-2.825-2.825zM12 12.152a4.576 4.576 0 1 0 0-9.152 4.576 4.576 0 0 0 0 9.152zm0-6.652a2.076 2.076 0 1 1 0 4.152 2.076 2.076 0 0 1 0-4.152z"/>
            </svg>
            <span>Одноклассники</span>
          </a>
        </div>

        <!-- Адрес -->
        <div class="mb-8">
          <h2 class="font-heading text-xl font-bold text-text mb-4">Приходите к нам</h2>
          <div class="flex items-start gap-3">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary shrink-0 mt-0.5">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
              <circle cx="12" cy="10" r="3"></circle>
            </svg>
            <span class="text-text-secondary">г. Благовещенск, ул. Центральная, Л31, Чигири</span>
          </div>
          <div class="flex items-start gap-3 mt-3">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary shrink-0 mt-0.5">
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
            <div>
              <span class="text-text-secondary">10:00–18:00 ежедневно</span>
              <div class="text-text-secondary text-sm">+6 часов к Москве</div>
            </div>
          </div>
        </div>
      </div>

      <!-- Правая колонка: форма -->
      <div>
        <h2 class="font-heading text-2xl font-bold text-text mb-2">Оставить заявку</h2>
        <p class="text-text-secondary text-sm mb-6">Опишите задачу — мы свяжемся в течение часа</p>
        <ContactForm />
      </div>
    </div>
  </section>

  <!-- Секция 3: Карта -->
  <section class="bg-primary-light py-8 md:py-12">
    <div class="max-w-7xl mx-auto px-4 md:px-6">
      <h2 class="font-heading text-2xl font-bold text-text mb-6 text-center">Как нас найти</h2>
      <div class="rounded-2xl overflow-hidden shadow-lg aspect-[16/9] md:aspect-[21/9]">
        <div class="bg-gray-200 w-full h-full flex items-center justify-center">
          <span class="text-text-secondary">Карта загружается...</span>
        </div>
      </div>
      <a href="https://2gis.ru/blagoveshchensk" class="text-primary hover:underline text-sm mt-3 text-center block">Открыть в 2ГИС</a>
    </div>
  </section>
</BaseLayout>
