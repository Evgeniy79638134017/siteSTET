---
const reviews = [
  {
    quote: 'Очень благодарны за подбор оборудования. Всё учли — и бюджет, и размер кабинета. Работаем уже полгода — всё отлично!',
    name: 'Анна К.',
    role: 'мастер маникюра',
    initial: 'А',
  },
  {
    quote: 'Марина всегда на связи, всегда посоветует. Даже в выходные отвечает. Такого сервиса больше нигде нет.',
    name: 'Елена М.',
    role: 'владелец салона',
    initial: 'Е',
  },
  {
    quote: 'Неужели в нашем городе это всё есть?! Думала, придётся заказывать из Москвы. А тут — пришла, потрогала, сразу купила.',
    name: 'Ольга Д.',
    role: 'мастер педикюра',
    initial: 'О',
  },
];
---

<section class="bg-white py-16 md:py-24">
  <div class="max-w-7xl mx-auto px-4 md:px-6">
    <!-- Заголовок -->
    <div class="text-center">
      <span class="text-primary font-semibold text-sm tracking-widest uppercase">Отзывы</span>
      <h2 class="font-heading text-3xl md:text-4xl font-bold text-text mt-2">Что говорят наши клиенты</h2>
    </div>

    <!-- Сетка -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-12">
      {reviews.map((review, i) => (
        <div class="bg-white rounded-2xl border border-gray-100 p-6 md:p-8 hover:shadow-md transition-all opacity-0 translate-y-4 duration-700" data-reveal data-reveal-delay={String(i * 100)}>
          <!-- Кавычки -->
          <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="currentColor" class="text-primary/20">
            <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z" />
          </svg>

          <p class="text-text leading-relaxed mt-4">&laquo;{review.quote}&raquo;</p>

          <div class="border-t border-gray-100 mt-6 pt-4">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-full bg-primary-light flex items-center justify-center text-primary font-bold text-sm">
                {review.initial}
              </div>
              <div>
                <p class="font-medium text-text">{review.name}</p>
                <p class="text-text-secondary text-sm">{review.role}</p>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
