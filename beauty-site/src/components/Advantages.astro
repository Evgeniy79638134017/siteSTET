---
const advantages = [
  {
    title: 'Всё в наличии',
    description: 'Пришёл, увидел и купил. Не нужно ждать доставку неделями.',
    icon: `<path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 01-8 0"/>`,
  },
  {
    title: 'Проверенное качество',
    description: 'Тестируем каждую новинку. Никогда не продаём заведомо плохой товар.',
    icon: `<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/>`,
  },
  {
    title: 'Всё в одном месте',
    description: 'Не нужно ходить по разным магазинам — мастер пришёл, мастер счастливый.',
    icon: `<path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/>`,
  },
  {
    title: 'Экспертная консультация',
    description: 'Подберём оборудование под ваш бюджет и задачи. Всегда говорим правду.',
    icon: `<path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/><path d="M16 3.13a4 4 0 010 7.75"/>`,
  },
  {
    title: 'Адекватные цены',
    description: 'Прямые поставки от фабрик без посредников. Официальные дилерства.',
    icon: `<line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6"/>`,
  },
  {
    title: 'Работаем с соцконтрактами',
    description: 'Поможем с бизнес-планом и подбором оборудования под бюджет контракта.',
    icon: `<path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/>`,
  },
  {
    title: 'Гарантия и сервис',
    description: 'Год гарантии по чеку. Возврат и ремонт брака без лишних вопросов.',
    icon: `<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>`,
  },
  {
    title: 'Удобная оплата',
    description: 'Разные способы оплаты. Кассовый чек сразу. Карты, наличные, перевод.',
    icon: `<rect x="1" y="4" width="22" height="16" rx="2" ry="2"/><line x1="1" y1="10" x2="23" y2="10"/>`,
  },
  {
    title: '6+ лет на рынке',
    description: 'Семейный бизнес с душой. Более 7 официальных дилерств ведущих брендов.',
    icon: `<polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>`,
  },
];
---

<section class="bg-white py-16 md:py-24">
  <div class="max-w-7xl mx-auto px-4 md:px-6">
    <!-- Заголовок -->
    <div class="text-center">
      <span class="text-primary font-semibold text-sm tracking-widest uppercase">Преимущества</span>
      <h2 class="font-heading text-3xl md:text-4xl font-bold text-text mt-2">Почему мастера выбирают нас</h2>
      <p class="text-text-secondary mt-3 max-w-2xl mx-auto">Больше, чем магазин — ваш партнёр в бьюти-бизнесе</p>
    </div>

    <!-- Сетка карточек -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 mt-12">
      {advantages.map((item) => (
        <div class="bg-white rounded-2xl p-6 border border-gray-100 hover:shadow-lg hover:-translate-y-1 transition-all">
          <div class="w-12 h-12 rounded-xl bg-primary-light flex items-center justify-center">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="text-primary"
              set:html={item.icon}
            />
          </div>
          <h3 class="font-semibold text-lg text-text mt-4">{item.title}</h3>
          <p class="text-text-secondary text-sm mt-2 leading-relaxed">{item.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
