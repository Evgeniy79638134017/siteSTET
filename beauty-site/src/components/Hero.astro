---
---

<section class="relative bg-gradient-to-br from-primary-light via-warm-pink to-white overflow-hidden">
  <!-- Декоративные круги -->
  <div class="absolute top-10 -left-20 w-72 h-72 rounded-full bg-primary/5"></div>
  <div class="absolute bottom-20 right-10 w-96 h-96 rounded-full bg-warm-pink/50"></div>
  <div class="absolute top-1/2 left-1/3 w-48 h-48 rounded-full bg-primary/5"></div>

  <div class="relative max-w-7xl mx-auto px-4 md:px-6 py-16 md:py-24">
    <div class="grid md:grid-cols-2 gap-8 md:gap-12 items-center">
      <!-- Левая часть — текст -->
      <div data-reveal class="opacity-0 translate-y-4 transition-all duration-700">
        <span class="inline-flex bg-warm-pink text-primary text-sm font-medium rounded-full px-4 py-1.5">
          6+ лет на рынке &bull; Благовещенск
        </span>

        <h1 class="font-heading text-4xl md:text-5xl lg:text-[56px] font-bold text-burgundy leading-tight mt-6">
          Создай свой идеальный салон красоты с&nbsp;нами
        </h1>

        <p class="text-text-secondary text-lg md:text-xl mt-4 md:mt-6 max-w-lg">
          Всё бьюти-оборудование в одном месте — от&nbsp;эконом до&nbsp;VIP. Прямые поставки от&nbsp;фабрик. Экспертная консультация и&nbsp;гарантия.
        </p>

        <div class="flex flex-col sm:flex-row gap-3 mt-8">
          <a
            href="https://wa.me/89244496355?text=%D0%97%D0%B4%D1%80%D0%B0%D0%B2%D1%81%D1%82%D0%B2%D1%83%D0%B9%D1%82%D0%B5!%20%D0%A5%D0%BE%D1%87%D1%83%20%D1%83%D0%B7%D0%BD%D0%B0%D1%82%D1%8C%20%D0%BF%D1%80%D0%BE%20%D0%BE%D0%B1%D0%BE%D1%80%D1%83%D0%B4%D0%BE%D0%B2%D0%B0%D0%BD%D0%B8%D0%B5"
            class="bg-cta text-white font-semibold text-lg rounded-xl px-10 py-4 shadow-lg hover:shadow-xl hover:bg-cta-dark transition-all text-center"
          >
            Написать в WhatsApp
          </a>
          <a
            href="/catalog"
            class="border-2 border-primary text-primary rounded-xl px-8 py-3.5 font-semibold hover:bg-primary hover:text-white transition-all text-center"
          >
            Смотреть каталог
          </a>
        </div>

        <div class="flex gap-6 mt-6 flex-wrap">
          <span class="text-sm text-text-secondary">&#10003; Работаем с соцконтрактами</span>
          <span class="text-sm text-text-secondary">&#10003; Доставка по ДВ</span>
          <span class="text-sm text-text-secondary">&#10003; Гарантия год</span>
        </div>
      </div>

      <!-- Правая часть — изображение -->
      <div class="relative" data-reveal data-reveal-delay="200">
        <div class="rounded-2xl overflow-hidden shadow-2xl">
          <div class="bg-gradient-to-br from-burgundy to-burgundy-light aspect-[4/3] flex flex-col items-center justify-center gap-3">
            <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="white" stroke-opacity="0.5" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
              <circle cx="8.5" cy="8.5" r="1.5"></circle>
              <polyline points="21 15 16 10 5 21"></polyline>
            </svg>
            <span class="text-white/50 text-lg">Фото салона</span>
          </div>
        </div>

        <!-- Плашка -->
        <div class="absolute bottom-4 right-4 bg-white rounded-xl shadow-lg p-3">
          <p class="text-xs text-text-secondary">Рекордный заказ</p>
          <p class="text-primary font-bold text-lg">350 000 &#8381;</p>
        </div>
      </div>
    </div>
  </div>
</section>
